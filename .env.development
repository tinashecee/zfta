# Loaded automatically in `npm run dev`. Points the app at your local API.
# Qwik SSR dev often does not forward Vite's `server.proxy` for `/api`, so same-origin
# requests stay on :5173 and return 404 with no hits on the backend — using this URL fixes that.
# Override per machine: create `.env.development.local` (gitignored) with a different URL.
VITE_API_BASE_URL=http://localhost:8080
